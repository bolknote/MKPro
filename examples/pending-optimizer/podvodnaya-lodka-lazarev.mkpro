reference lazarev_podvodnaya_lodka_lazarev

// «Подводная лодка» Феликса Лазарева: порт реконструкции из соседнего .txt.
// Это правила игры, а не размещение команд или регистров оригинала.
program PodvodnayaLodka {
  state {
    // Только начальная настройка. Во время игры переключатель меняет режим.
    expected_mode("grd")
    depth: counter 0..3 = 0
    air: counter -10..52 = 20
    ship: counter 0..10 = 0
    draw: packed = 0.3141592
    movement: counter -1..1 = 0
    next_depth: counter -1..4 = 0
  }

  loop {
    // Позиции считаются слева направо, от 1 до 8; позиция 0 невидима.
    // На поверхности лодка занимает седьмую клетку, под водой первая
    // клетка показывает глубину. Эсминец перекрывает предыдущие символы.
    // Воздух остаётся в поле порядка даже при значениях 01..07.
    preview(frame("--------", air,
      at(sign(depth), depth),
      at(7 * (1 - sign(depth)), "8"),
      at(ship, "E")))

    // Р: вниз, ГРД: держать глубину, Г: вверх. Не заменять на read():
    // оригинал работает непрерывно, без С/П между кадрами.
    next_depth = depth + sign(cos(100))
    if next_depth < 0 { next_depth = 0 }
    if next_depth > 3 { next_depth = 3 }
    movement = next_depth - depth
    depth = next_depth

    // Заблокированное движение у поверхности или дна считается покоем;
    // прибытие к границе остаётся движением и влияет на обнаружение.
    air += air_change(depth)
    if air > 50 { air = 50 }
    if air <= 0 { halt("ЕГГОГ") }

    // Одна выборка на весь ход, как в оригинале. Целая часть задаёт
    // скорость, дробная часть того же числа участвует в обнаружении.
    // Предыдущее значение остаётся seed: постоянный запас воздуха
    // не должен замораживать генератор случайных чисел.
    draw = random(0, 2, draw)
    if ship == 0 {
      if draw < 0.5 { ship = 1 }
    }
    else {
      ship += 1 + int(draw)
      if ship > 8 {
        // Между ушедшим и новым эсминцем обязательно есть пустой кадр.
        ship = 0
      }
      else {
        if movement != 0 {
          detect(0.25)
        }
        else {
          if depth < 2 { detect(0.5) }
        }
      }
    }
  }

  fn air_change(level) {
    if level == 0 { return 2 }
    if level == 1 { return -2 }
    if level == 2 { return -5 }
    return -10
  }

  fn detect(chance) {
    // Прыжок через шестую позицию столь же опасен, как попадание на неё.
    if ship >= 6 { halt("ЕГГОГ") }
    if ship == 5 {
      if frac(draw) < chance { halt("ЕГГОГ") }
    }
  }
}
