reference anvarov_tic_tac_toe_4x4

// Compact port of Serge Anvarov's 4x4 torus tic-tac-toe. Four packed line
// registers (44444.4) track vertical, horizontal, and both diagonal families;
// the calculator picks the free cell with the largest squared imbalance sum.

program TicTacToe4x4 {
  grid: board(1..4, 1..4)

  state {
    expected_mode_only("deg")

    occupied: packed = 0
    previous_occupied: packed
    lines: packed[4..7] = [44444.4, 44444.4, 44444.4, 44444.4]

    // Coordinates also carry raw keyboard input before normalization. Keep
    // the displayed response separate so reports never overwrite a coordinate.
    x: packed = 0
    y: packed = 0
    display_x: packed = 0

    best_y: packed = 0
    best_score: packed
    score: packed
    line: packed
    slot: packed
    report: packed
  }

  fn draw() {
    halt(0)
  }

  fn occupied_cell() {
    display_x = -99999999
  }

  loop {
    // The documented answer is the stack pair X:Y.  preview(y) prepares Y;
    // The response may be a coordinate, a retry sentinel, or a win report.
    preview(y)
    show(display_x)
    // Source UI is X ПП Y С/П: ПП executes only the first entered() store,
    // then С/П resumes at the second one with the new X value. Keep both
    // entered() assignments explicit: y = entered() is the second interactive
    // input phase, not redundant source state. The compiler may forward its
    // current X directly into grid_norm and omit only the physical X->P y cell.
    x = entered()
    y = entered()
    // Use the same calculator primitive as the original listing. It truncates
    // ordinary fractional aliases into 1..4 and preserves the MK-61's own
    // eight-digit rounding at extreme inputs. Normalize Y first so the two
    // manual-entry phases retain their original stack flow.
    y = grid_norm(y)
    x = grid_norm(x)
    line = cell_mask(x, y)

    // The original writes the union first, then compares old and new values.
    // Testing intersection is not equivalent for a multi-bit mask, which can
    // arise from the calculator's rounding of out-of-range keyboard input.
    previous_occupied = occupied
    occupied = bit_or(occupied, line)
    if previous_occupied == occupied {
      occupied_cell()
    }
    else {
      mark_lines_and_check(-1)
      choose_calculator_move()
      occupied = bit_or(occupied, line)
      mark_lines_and_check(1)
    }
  }

  fn mark_one() {
    // Walk the four line banks 7..4 by self-decrementing the shared selector,
    // so callers no longer spend a literal cell per bank index.
    slot--
    // Lines are one-based: line 1 changes units, not tens. The original
    // multiplies pow10(line) by +/-0.1. Keep that operation order rather
    // than shifting the exponent: MK-61 rounding is observable here.
    lines[slot] = packed_add(lines[slot], line, best_score / 10)
    // A win records the fractional report but does not interrupt the traversal.
    // The last winning line is reported after all four banks have been updated.
    report = frac(bit_and(lines[slot], 88888834))
    if report != 0 {
      display_x = report
    }
  }

  fn mark_lines_and_check(mark_sign) {
    best_score = mark_sign
    slot = 8
    display_x = x
    line = x
    mark_one()
    line = y
    mark_one()
    normalize(x + y)
    mark_one()
    normalize(x - y)
    mark_one()
  }

  fn choose_calculator_move() {
    // The original scans X first, then Y, both descending. Equal scores
    // replace the previous best, so exchanging these loops changes the move.
    x = 4

    while x >= 1 {
      y = 4
      while y >= 1 {
        unless frac(bit_and(occupied, cell_mask(x, y))) {
          candidate_score()
          best_score = max(score, best_score)
          if score == best_score {
            slot = x
            best_y = y
          }
        }
        y--
      }
      x--
    }

    if best_score < 0 {
      draw()
    }

    x = slot
    y = best_y
    line = cell_mask(x, y)
  }

  fn candidate_score() {
    // The original starts its accumulator at 98. Keep the same left-to-right
    // additions: eight-digit rounding affects score ties and the chosen move.
    score = 98 + packed_score(lines[7], x) + packed_score(lines[6], y)
    normalize(x + y)
    score += packed_score(lines[5], line)
    normalize(x - y)
    score += packed_score(lines[4], line)
  }

  fn normalize(raw_line) {
    // Reuse the exact signed width-four primitive here too. In particular,
    // this preserves the original calculator's eight-digit rounding behavior
    // when an out-of-range keyboard value produces a fractional remainder.
    line = grid_norm(raw_line)
  }
}
