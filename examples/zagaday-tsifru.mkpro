// Neural number-guessing game published by Hs On in the Telegram chat
// "МК61 / МК52 / МК85" on 2026-07-14.
//
// Semantic counterpart of Sergey Anvarov's corrected 105-cell handwritten
// revision in games/logic/zagaday-tsifru-hs-on.txt. Seven previous octal digits
// form 21 binary inputs. Three binary threshold neurons predict bits 4, 2, and 1.

program ZagadayTsifru {
  const FULL_BITS = 7.7777777
  const PUBLISHED_THRESHOLD_FACTOR = 0.054000098

  state {
    expected_mode_only("grd")

    weights: packed[1..3] = [0, 0, 0]
    history: packed = 8

    score: counter -999..999 = 0
    prediction: counter 0..7 = 0
    player: counter 0..7 = 0

    ones: counter 0..21 = 0
    remaining: counter 0..7 = 0
    neuron_index: counter 1..3 = 1
    digit: counter 0..7 = 0
    half: counter 0..3 = 0
    correction: packed = 0
  }

  // Count differing bits in the seven octal digits. Each decimal digit is in
  // 0..7, where popcount(d) = d - floor(d / 2) - floor(d / 4).
  fn hamming_distance(weight) {
    weight = frac(bit_and(bit_xor(history, weight), FULL_BITS))
    ones = 0
    remaining = 7

    while remaining >= 1 {
      weight *= 10
      digit = int(weight)
      half = int(digit / 2)
      ones += digit - half - int(half / 2)
      weight = frac(weight)

      remaining--
    }

    // For integer ones in 0..21 this is exactly the published
    // int((ones + 8) * PUBLISHED_THRESHOLD_FACTOR), while exposing the
    // majority threshold directly to the compiler.
    return int((ones + 8) / 19)
  }

  loop {
    prediction = 0
    neuron_index = 3
    while neuron_index >= 1 {
      prediction = prediction * 2 + hamming_distance(weights[neuron_index])
      neuron_index--
    }

    // The semantic source uses two ordinary resumable screens. The handwritten
    // listing packs the score and preceding prediction into X and Y at one stop,
    // accepts the next digit with С/П, and keeps the next prediction hidden.
    show(score)
    player = entered(0, 7)
    show(prediction)

    score += 8 * abs(sign(player - prediction)) - 7

    // Form the correction mask for every neuron. A matching output bit makes
    // its mismatch mask zero. The final revision replaces К СЧ with a
    // deterministic BCD mask obtained from sin(correction).
    ones = 4
    neuron_index = 3
    while neuron_index >= 1 {
      correction = bit_and(
        bit_xor(
          bit_xor(history, weights[neuron_index]),
          bit_and(player, ones) / ones * FULL_BITS
        ),
        bit_and(bit_xor(player, prediction), ones) / ones * FULL_BITS
      )
      weights[neuron_index] = bit_xor(
        bit_and(correction, sin(correction)),
        weights[neuron_index]
      )
      ones /= 2
      neuron_index--
    }

    // Adding 2 to the anchored 8.NNNNNNN value normalizes it to 10.NNNNNNN,
    // which shifts the seven payload digits exactly before the new digit is
    // merged. Unlike the old 1.9999996 carry, an all-zero history stays zero.
    history = bit_or(history + 2, 10 + player)
  }
}
